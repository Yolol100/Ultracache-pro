# WordPress plugin development
# Keep runtime plugin files tracked; ignore local/dev/build artifacts.

# OS / editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment / local config
.env
.env.*
!.env.example
*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies / package managers
node_modules/
vendor/
composer.phar
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Build caches
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.phpunit.result.cache
.phpcs-cache

# Test / coverage output
coverage/
.nyc_output/
tests/_output/
.phpunit.cache/

# WordPress local installs and generated content
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/debug.log

# Plugin runtime cache and generated artifacts
cache/
.cache/
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig

# Release packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Generated source maps usually should not ship unless intentionally needed
*.map

# Keep important runtime/docs files tracked
!readme.txt
!README.md
!LICENSE
!license.txt
!languages/
!languages/*.pot
!languages/*.po
!languages/*.mo
!assets/
!includes/
!admin/
!public/
